# US Career Solutions - Environment Variables Template
# Copy this file to .env.local for local development

# Secret key to authenticate Vercel Cron triggers (configured in Vercel Project Settings)
CRON_SECRET=your_custom_secure_cron_secret_here

# Optional: Google Gemini API key for advanced AI Resume Tailoring and Outreach Generation
# If omitted, intelligent built-in semantic heuristic generators will handle analysis automatically.
GEMINI_API_KEY=

# Optional: USAJOBS API key for extended government & cap-exempt jobs indexing
USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=

# Community links (displayed across the app)
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/your-group-id
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=https://t.me/your_channel
NEXT_PUBLIC_FACEBOOK_PAGE_URL=https://facebook.com/1127204940483396
